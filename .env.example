# PostgreSQL
DATABASE_URL="postgresql://postgres:root1234@localhost:5432/grh_emmn"

# API
PORT=3001
NODE_ENV=development

# Sécurité / JWT
JWT_SECRET="changez-moi-avant-production"
JWT_EXPIRES_IN="8h"

# Politique comptes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10
FIRST_LOGIN_TOKEN_TTL_HOURS=48

# Frontend (CORS / URLs)
WEB_ORIGIN="http://localhost:5173"
API_BASE_URL="/api"
API_FULL_URL="http://localhost:3001/api"

# Stockage fichiers
STORAGE_DRIVER=local            # local | s3
UPLOAD_DIR="./data/uploads"
MAX_FILE_SIZE_MB=20
ALLOWED_MIME="application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# S3 / MinIO (facultatif, si STORAGE_DRIVER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="grh-emmn"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# Fuseau
TZ="Indian/Antananarivo"