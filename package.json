{
  "name": "grh-emmn",
  "private": true,
  "version": "1.0.0",
  "description": "GRH EMMN — Gestion des Ressources Humaines de l'État-Major de la Marine Nationale",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @grh/api && npm run build -w @grh/web",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev -w @grh/api\" \"npm:dev -w @grh/web\"",
    "dev:api": "npm run dev -w @grh/api",
    "dev:web": "npm run dev -w @grh/web",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "lint": "npm run lint -w @grh/api && npm run lint -w @grh/web",
    "test": "npm run test -w @grh/api",
    "typecheck": "npm run typecheck -w @grh/api && npm run typecheck -w @grh/web"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true
  }
}
